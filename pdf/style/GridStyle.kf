package pdf.style

import pdf.style.PdfColor
import pdf.style.Colors
import pdf.style.TextStyle

class GridStyle {
    Int height
    Int cellPadding
    Int borderSize
    PdfColor headerFill
    PdfColor cellFill
    PdfColor border
    TextStyle headerText
    TextStyle cellText

    constructor() {
        height = 24
        cellPadding = 5
        borderSize = 1
        headerFill = Colors.white
        cellFill = Colors.white
        border = Colors.black
        headerText = TextStyle().fontSize(10)
        cellText = TextStyle().fontSize(10)
    }

    rowHeight(Int value): GridStyle {
        if (value <= 0) {
            throw "A altura da linha precisa ser maior que zero"
        }
        height = value
        return this
    }

    padding(Int value): GridStyle {
        if (value < 0) {
            throw "O padding não pode ser negativo"
        }
        cellPadding = value
        return this
    }

    borderWidth(Int value): GridStyle {
        if (value < 0) {
            throw "A largura da borda não pode ser negativa"
        }
        borderSize = value
        return this
    }

    headerBackground(PdfColor value): GridStyle {
        headerFill = value
        return this
    }

    cellBackground(PdfColor value): GridStyle {
        cellFill = value
        return this
    }

    borderColor(PdfColor value): GridStyle {
        border = value
        return this
    }

    headerStyle(TextStyle value): GridStyle {
        headerText = value.copy()
        return this
    }

    cellStyle(TextStyle value): GridStyle {
        cellText = value.copy()
        return this
    }
}
