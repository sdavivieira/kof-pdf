package pdf

import pdf.PdfElement
import pdf.TextElement
import pdf.GridElement
import pdf.style.PdfColor
import pdf.style.TextAlign
import pdf.style.TextStyle
import pdf.style.GridStyle

class LayoutEngine {
    Int pageWidth = 595
    Int pageHeight = 842
    Int marginLeft = 40
    Int marginRight = 40
    Int marginTop = 40

    layout(List<PdfElement> elements): String {
        var commands = ""
        var y = pageHeight - marginTop

        for (var element in elements) {
            if (element instanceof TextElement) {
                var text = element as TextElement
                var textX = marginLeft
                var textY = y

                if (text.positioned) {
                    textX = text.x
                    textY = text.y
                }

                commands = commands + drawStyledText(
                    text.content,
                    textX,
                    textY,
                    text.boxWidth,
                    text.textStyle
                )
                y = textY - text.spacingAfter
            } else if (element instanceof GridElement) {
                var grid = element as GridElement
                var result = drawGrid(grid, y)
                commands = commands + result.commands
                y = result.nextY
            }
        }

        return commands
    }

    drawGrid(GridElement grid, Int startY): GridLayoutResult {
        var commands = ""
        var y = startY
        var availableWidth = pageWidth - marginLeft - marginRight
        var columnWidths = resolveColumnWidths(grid, availableWidth)
        var style = grid.gridStyle

        validateGridStyle(columnWidths, style)

        if (!grid.headerCells.isEmpty()) {
            commands = commands + drawGridRow(
                grid.headerCells,
                columnWidths,
                y,
                style.headerText,
                style.headerFill,
                style
            )
            y = y - style.height
        }

        for (var row in grid.gridRows) {
            commands = commands + drawGridRow(
                row.cells,
                columnWidths,
                y,
                style.cellText,
                style.cellFill,
                style
            )
            y = y - style.height
        }

        return GridLayoutResult(commands, y - 12)
    }

    resolveColumnWidths(GridElement grid, Int availableWidth): List<Int> {
        if (!grid.customWidths.isEmpty()) {
            var total = 0
            for (var width in grid.customWidths) {
                total = total + width
            }

            if (total > availableWidth) {
                throw "A soma das larguras do grid ultrapassa a largura útil da página"
            }

            return grid.customWidths
        }

        var widths = listOf<Int>()
        var baseWidth = availableWidth / grid.columns
        var usedWidth = 0

        for (var index = 0; index < grid.columns; index++) {
            var width = baseWidth
            if (index == grid.columns - 1) {
                width = availableWidth - usedWidth
            }
            widths.add(width)
            usedWidth = usedWidth + width
        }

        return widths
    }

    validateGridStyle(List<Int> widths, GridStyle style) {
        if (style.headerText.size + style.cellPadding * 2 > style.height) {
            throw "O estilo do header não cabe na altura da linha"
        }
        if (style.cellText.size + style.cellPadding * 2 > style.height) {
            throw "O estilo das células não cabe na altura da linha"
        }
        for (var width in widths) {
            if (style.cellPadding * 2 >= width) {
                throw "O padding do grid não cabe na largura da coluna"
            }
        }
    }

    drawGridRow(
        List<String> cells,
        List<Int> widths,
        Int top,
        TextStyle textStyle,
        PdfColor background,
        GridStyle gridStyle
    ): String {
        var commands = ""
        var x = marginLeft

        for (var index = 0; index < widths.size; index++) {
            var columnWidth = widths.get(index)
            var bottom = top - gridStyle.height

            commands = commands + drawFilledRectangle(
                x,
                bottom,
                columnWidth,
                gridStyle.height,
                background
            )

            if (gridStyle.borderSize > 0) {
                commands = commands + drawBorderRectangle(
                    x,
                    bottom,
                    columnWidth,
                    gridStyle.height,
                    gridStyle.borderSize,
                    gridStyle.border
                )
            }

            if (index < cells.size) {
                var innerX = x + gridStyle.cellPadding
                var innerWidth = columnWidth - gridStyle.cellPadding * 2
                var baseline = top - gridStyle.cellPadding - textStyle.size
                commands = commands + drawStyledText(
                    cells.get(index),
                    innerX,
                    baseline,
                    innerWidth,
                    textStyle
                )
            }

            x = x + columnWidth
        }

        return commands
    }

    drawStyledText(String value, Int x, Int y, Int width, TextStyle style): String {
        var textX = x

        if (width > 0) {
            var measuredWidth = estimateTextWidth(value, style.size)
            if (measuredWidth < width) {
                if (style.alignment == TextAlign.center) {
                    textX = x + (width - measuredWidth) / 2
                } else if (style.alignment == TextAlign.right) {
                    textX = x + width - measuredWidth
                }
            }
        }

        return "q\n" + fillColor(style.color) +
            "BT /F1 " + style.size + " Tf " + textX + " " + y +
            " Td (" + escapePdf(value) + ") Tj ET\nQ\n"
    }

    estimateTextWidth(String value, Int fontSize): Int {
        return value.length * fontSize * 6 / 10
    }

    drawFilledRectangle(Int x, Int y, Int width, Int height, PdfColor color): String {
        return "q\n" + fillColor(color) + x + " " + y + " " + width + " " + height + " re f\nQ\n"
    }

    drawBorderRectangle(Int x, Int y, Int width, Int height, Int borderWidth, PdfColor color): String {
        return "q\n" + strokeColor(color) + borderWidth + " w\n" +
            x + " " + y + " " + width + " " + height + " re S\nQ\n"
    }

    fillColor(PdfColor color): String {
        return colorComponent(color.red) + " " + colorComponent(color.green) + " " +
            colorComponent(color.blue) + " rg\n"
    }

    strokeColor(PdfColor color): String {
        return colorComponent(color.red) + " " + colorComponent(color.green) + " " +
            colorComponent(color.blue) + " RG\n"
    }

    colorComponent(Int value): String {
        if (value <= 0) {
            return "0"
        }
        if (value >= 255) {
            return "1"
        }

        var scaled = value * 1000 / 255
        var digits = "" + scaled
        while (digits.length < 3) {
            digits = "0" + digits
        }
        return "0." + digits
    }

    escapePdf(String value): String {
        var escaped = ""

        for (var index = 0; index < value.length; index++) {
            var code = value.charAt(index)

            if (code == 40) {
                escaped = escaped + "\\("
            } else if (code == 41) {
                escaped = escaped + "\\)"
            } else if (code == 92) {
                escaped = escaped + "\\\\"
            } else if (code >= 32 && code <= 126) {
                escaped = escaped + value.substring(index, index + 1)
            } else if (code >= 160 && code <= 255) {
                escaped = escaped + "\\" + toOctalByte(code)
            } else {
                escaped = escaped + "?"
            }
        }

        return escaped
    }

    toOctalByte(Int value): String {
        var first = value / 64
        var remainder = value % 64
        var second = remainder / 8
        var third = remainder % 8
        return "" + first + second + third
    }
}

class GridLayoutResult {
    String commands
    Int nextY

    constructor(String commands, Int nextY) {
        this.commands = commands
        this.nextY = nextY
    }
}
